ROUTEMIND_ENV=development
ROUTEMIND_DATA_ROOT=F:\Projects\RouteMind-Data
BUSINESS_API_PORT=18080
COMPUTE_API_PORT=18081
# Inject externally for an approved Google Routes validation only; never commit a value.
ROUTEMIND_GOOGLE_ROUTES_API_KEY=
POSTGRES_DB=routemind
POSTGRES_USER=routemind
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=15432
RABBITMQ_DEFAULT_USER=routemind
RABBITMQ_DEFAULT_PASS=change-me-local-only
RABBITMQ_AMQP_PORT=15673
RABBITMQ_MANAGEMENT_PORT=15674
REDIS_PASSWORD=change-me-local-only
REDIS_PORT=16379
POSTGRES_IMAGE=postgres:18.6-alpine
RABBITMQ_IMAGE=rabbitmq:4.3.5-management-alpine
REDIS_IMAGE=redis:8.10.1-alpine
ROUTEMIND_EDGE_SECURITY_ENABLED=true
ROUTEMIND_EDGE_POLICY_VERSION=edge-v1
ROUTEMIND_EDGE_WINDOW_SECONDS=60
ROUTEMIND_EDGE_BURST_ALLOWANCE=20
ROUTEMIND_EDGE_ANONYMOUS_REQUESTS=60
ROUTEMIND_EDGE_AUTHENTICATED_REQUESTS=120
ROUTEMIND_EDGE_CUSTOMER_REQUESTS=180
ROUTEMIND_EDGE_COURIER_REQUESTS=300
ROUTEMIND_EDGE_MERCHANT_REQUESTS=240
ROUTEMIND_EDGE_ANALYST_REQUESTS=300
ROUTEMIND_EDGE_OPERATOR_REQUESTS=600
ROUTEMIND_EDGE_MAX_TRACKED_KEYS=10000
ROUTEMIND_EDGE_MAX_HEADER_COUNT=64
ROUTEMIND_EDGE_MAX_HEADER_BYTES=16384
ROUTEMIND_EDGE_MAX_QUERY_BYTES=4096
ROUTEMIND_EDGE_MAX_PATH_BYTES=2048
ROUTEMIND_EDGE_MAX_BODY_BYTES=1048576
