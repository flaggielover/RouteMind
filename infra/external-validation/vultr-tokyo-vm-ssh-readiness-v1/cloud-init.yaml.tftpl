#cloud-config
package_update: false
package_upgrade: false
ssh_pwauth: false
disable_root: false
write_files:
  - path: /etc/routemind-ssh-readiness.json
    owner: root:root
    permissions: "0600"
    content: |
      {"executionId":"${execution_id}","expectedPublicKeySha256":"${expected_public_key_sha256}","expectedSshUsername":"${expected_ssh_username}","region":"nrt","schema":"r4-vm-ssh-readiness-guest-config.v1"}
  - path: /usr/local/sbin/routemind-ssh-readiness-snapshot
    owner: root:root
    permissions: "0755"
    content: |
      #!/usr/bin/env python3
      import base64
      import hashlib
      import json
      import pathlib
      import subprocess
      import sys
      from datetime import datetime, timezone

      ROOT = pathlib.Path("/var/lib/routemind-ssh-readiness")
      CONFIG = pathlib.Path("/etc/routemind-ssh-readiness.json")
      OUTPUT = ROOT / "guest-readiness.json"

      def run(*args):
          result = subprocess.run(args, capture_output=True, text=True, check=False)
          return result.returncode, result.stdout.strip()

      def fingerprint(path):
          if not path.is_file():
              return []
          code, output = run("ssh-keygen", "-lf", str(path), "-E", "sha256")
          if code != 0:
              return []
          return [line.split()[1] for line in output.splitlines() if len(line.split()) >= 2]

      def mode(path):
          try:
              return oct(path.stat().st_mode & 0o777)
          except FileNotFoundError:
              return "MISSING"

      config = json.loads(CONFIG.read_text(encoding="utf-8"))
      phase = sys.argv[1] if len(sys.argv) == 2 else "UNSPECIFIED"
      cloud_code, cloud_status = run("cloud-init", "status")
      ssh_code, ssh_status = run("systemctl", "is-active", "ssh.service")
      listen_code, listen_output = run("ss", "-H", "-lnt", "sport = :22")
      syntax_code, _ = run("sshd", "-t")
      ssh_directory = pathlib.Path("/root/.ssh")
      authorized_keys = ssh_directory / "authorized_keys"
      authorized = fingerprint(authorized_keys)
      host_keys = fingerprint(pathlib.Path("/etc/ssh/ssh_host_ed25519_key.pub"))
      expected = config["expectedPublicKeySha256"]
      artifact = {
          "authorizedKeyFingerprintMatch": expected in authorized,
          "authorizedKeyFingerprints": authorized,
          "authorizedKeysMode": mode(authorized_keys),
          "cloudInitCommandExit": cloud_code,
          "cloudInitStatus": cloud_status,
          "executionId": config["executionId"],
          "expectedPublicKeySha256": expected,
          "expectedSshUsername": config["expectedSshUsername"],
          "generatedAt": datetime.now(timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z"),
          "hostKeyFingerprints": host_keys,
          "phase": phase,
          "region": config["region"],
          "schema": "r4-vm-ssh-readiness-guest-artifact.v1",
          "sshDirectoryMode": mode(ssh_directory),
          "sshListenerPresent": listen_code == 0 and bool(listen_output),
          "sshdConfigValid": syntax_code == 0,
          "sshServiceActive": ssh_code == 0 and ssh_status == "active",
      }
      ROOT.mkdir(mode=0o700, parents=True, exist_ok=True)
      temporary = OUTPUT.with_suffix(".tmp")
      payload = json.dumps(artifact, sort_keys=True, separators=(",", ":")) + "\n"
      temporary.write_text(payload, encoding="utf-8")
      temporary.chmod(0o600)
      temporary.replace(OUTPUT)
      digest = hashlib.sha256(payload.encode("utf-8")).hexdigest()
      encoded = base64.b64encode(payload.encode("utf-8")).decode("ascii")
      try:
          pathlib.Path("/dev/console").write_text(
              "ROUTEMIND_SSH_READINESS_SHA256=" + digest + "\n"
              + "ROUTEMIND_SSH_READINESS_JSON_BASE64=" + encoded + "\n",
              encoding="ascii",
          )
      except OSError:
          pass
runcmd:
  - [mkdir, -p, /var/lib/routemind-ssh-readiness]
  - [chmod, "0700", /var/lib/routemind-ssh-readiness]
  - [/usr/local/sbin/routemind-ssh-readiness-snapshot, CLOUD_FINAL_RUNNING]
  - [systemd-run, --unit=routemind-ssh-readiness-post-cloud-init, --on-active=30s, /bin/sh, -c, "cloud-init status --wait >/dev/null 2>&1; /usr/local/sbin/routemind-ssh-readiness-snapshot POST_CLOUD_INIT"]
final_message: "RouteMind SSH readiness marker scheduled"
