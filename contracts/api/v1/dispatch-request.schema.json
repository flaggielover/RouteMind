{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.routemind.local/api/v1/dispatch-request.schema.json",
  "title": "RouteMind Dispatch Request v1",
  "$defs": {
    "geoPoint": {
      "type": "object",
      "required": ["latitude", "longitude"],
      "properties": {
        "latitude": {"type": "number", "minimum": -90, "maximum": 90},
        "longitude": {"type": "number", "minimum": -180, "maximum": 180}
      },
      "additionalProperties": false
    },
    "timeWindow": {
      "type": "object",
      "required": ["startSeconds", "endSeconds"],
      "properties": {
        "startSeconds": {"type": "number", "minimum": 0},
        "endSeconds": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": ["requestId", "pickup", "candidates"],
  "properties": {
    "requestId": {"type": "string", "format": "uuid"},
    "pickup": {"$ref": "#/$defs/geoPoint"},
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["courierId", "location"],
        "properties": {
          "courierId": {"type": "string", "format": "uuid"},
          "location": {"$ref": "#/$defs/geoPoint"},
          "capacityUnits": {"type": "number", "minimum": 0},
          "currentLoadUnits": {"type": "number", "minimum": 0},
          "availableFromSeconds": {"type": "number", "minimum": 0},
          "availableUntilSeconds": {"type": ["number", "null"], "minimum": 0},
          "state": {"enum": ["available", "on_route", "offline", "paused"]},
          "serviceRisk": {"type": "number", "minimum": 0, "maximum": 1},
          "overtimeRisk": {"type": "number", "minimum": 0, "maximum": 1},
          "estimatedTravelSeconds": {"type": "number", "minimum": 0}
        },
        "additionalProperties": false
      }
    },
    "demandUnits": {"type": "number", "exclusiveMinimum": 0},
    "pickupReadyAtSeconds": {"type": "number", "minimum": 0},
    "serviceSeconds": {"type": "number", "minimum": 0},
    "deliveryWindow": {"$ref": "#/$defs/timeWindow"},
    "maxServiceRisk": {"type": "number", "minimum": 0, "maximum": 1}
  },
  "additionalProperties": false
}
