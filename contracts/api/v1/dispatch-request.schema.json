{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.routemind.local/api/v1/dispatch-request.schema.json",
  "title": "RouteMind Dispatch Request v1",
  "$defs": {
    "geoPoint": {
      "type": "object",
      "required": ["latitude", "longitude"],
      "properties": {
        "latitude": {"type": "number", "minimum": -90, "maximum": 90},
        "longitude": {"type": "number", "minimum": -180, "maximum": 180}
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": ["requestId", "pickup", "candidates"],
  "properties": {
    "requestId": {"type": "string", "format": "uuid"},
    "pickup": {"$ref": "#/$defs/geoPoint"},
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["courierId", "location"],
        "properties": {
          "courierId": {"type": "string", "format": "uuid"},
          "location": {"$ref": "#/$defs/geoPoint"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
