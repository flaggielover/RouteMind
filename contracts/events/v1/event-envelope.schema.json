{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.routemind.local/events/v1/event-envelope.schema.json",
  "title": "RouteMind Event Envelope v1",
  "type": "object",
  "required": ["specVersion", "eventId", "eventType", "occurredAt", "producer", "aggregateId", "aggregateVersion", "correlationId", "causationId", "traceId", "payload"],
  "properties": {
    "specVersion": {"const": "1.0"},
    "eventId": {"type": "string", "format": "uuid"},
    "eventType": {"type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)+$"},
    "occurredAt": {"type": "string", "format": "date-time"},
    "producer": {"type": "string", "minLength": 1},
    "aggregateId": {"type": "string", "format": "uuid"},
    "aggregateVersion": {"type": "integer", "minimum": 1},
    "correlationId": {"type": "string", "format": "uuid"},
    "causationId": {"type": ["string", "null"], "format": "uuid"},
    "traceId": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "payload": {"type": "object"}
  },
  "additionalProperties": false
}
