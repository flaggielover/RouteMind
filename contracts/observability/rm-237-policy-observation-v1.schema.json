{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://routemind.dev/contracts/observability/rm-237-policy-observation-v1.schema.json",
  "title": "RouteMind future policy observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "decision_id", "request_id", "tick", "clock_domain",
    "previous_policy", "selected_policy", "switch_occurred", "switch_reason",
    "selection_mode", "policy_version", "configuration_digest", "deterministic_seed",
    "fallback_state", "state", "semantics", "consequences", "provenance",
    "observation_semantics"
  ],
  "properties": {
    "schema_version": {"const": "routemind-policy-observation-v1"},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "scenario_id": {"type": ["string", "null"], "maxLength": 256},
    "decision_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "tick": {"type": "integer", "minimum": 0},
    "timestamp": {"type": ["string", "null"], "format": "date-time"},
    "clock_domain": {"enum": ["WALL", "SIMULATED", "REPLAY"]},
    "previous_policy": {"type": "string", "minLength": 1},
    "selected_policy": {"type": "string", "minLength": 1},
    "switch_occurred": {"type": "boolean"},
    "switch_reason": {"type": "string", "minLength": 1},
    "selection_mode": {"type": "string", "minLength": 1},
    "policy_version": {"type": "string", "minLength": 1},
    "configuration_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "deterministic_seed": {"type": ["integer", "null"], "minimum": 0},
    "fallback_state": {"type": "string", "minLength": 1},
    "state": {"type": "object", "additionalProperties": true},
    "semantics": {
      "type": "object",
      "additionalProperties": {"enum": ["OBSERVED", "DERIVED", "SIMULATOR_ONLY", "CONFIGURATION", "MODEL_OUTPUT"]}
    },
    "consequences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "value", "unit", "provenance"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "status": {"enum": ["MEASURED", "DERIVED", "UNAVAILABLE", "NOT_APPLICABLE"]},
          "value": {},
          "unit": {"type": ["string", "null"]},
          "provenance": {"type": ["string", "null"]}
        }
      }
    },
    "provenance": {"type": "object", "additionalProperties": {"type": "string"}},
    "observation_semantics": {"const": "observational_association; not causal_switch_cost"}
  }
}
